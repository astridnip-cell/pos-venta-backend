# Copia este archivo como ".env" (junto a package.json) y llena los valores.
# El archivo .env NUNCA se sube a GitHub.
# Los valores que ya tienes en tu .env (HOST, PORT, APP_KEYS, ADMIN_JWT_SECRET,
# API_TOKEN_SALT, TRANSFER_TOKEN_SALT, ENCRYPTION_KEY, JWT_SECRET) se dejan como están:
# solo AGREGA las líneas de abajo.

# --- Wompi (pagos) ---
# Se obtienen en tu cuenta de Wompi, sección "Desarrolladores" (modo pruebas).
WOMPI_ENV=sandbox
WOMPI_PUBLIC_KEY=pub_test_xxxxxxxxxxxxxxxx
WOMPI_INTEGRITY_SECRET=test_integrity_xxxxxxxxxxxxxxxx
WOMPI_EVENTS_SECRET=test_events_xxxxxxxxxxxxxxxx

# --- Tienda ---
# Dirección de la tienda (a donde vuelve el cliente después de pagar)
FRONTEND_URL=http://localhost:3000

# --- Envío (pesos colombianos) ---
SHIPPING_FREE_FROM=150000
SHIPPING_COST=12000
